FROM docker.io/library/debian:trixie-slim
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      poppler-utils mupdf-tools ghostscript python3 python3-venv ca-certificates \
      libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 \
      texlive-latex-base texlive-latex-recommended texlive-fonts-recommended lmodern \
      fonts-noto-core fonts-noto-cjk fonts-linuxlibertine fonts-dejavu-core fonts-dejavu-extra wamerican \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /venv && /venv/bin/pip install --no-cache-dir pypdfium2 reportlab rapidfuzz weasyprint pypdf
ENV PATH=/venv/bin:$PATH
WORKDIR /bench
