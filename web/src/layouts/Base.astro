---
// The frame of each page: the title, the navigation and the plain CSS of the site.
interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;
const links = [
  ["/", "Account"],
  ["/upload", "Upload"],
  ["/documents", "Documents"],
  ["/search", "Search"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Strata (local)</title>
  </head>
  <body>
    <header>
      <span class="brand">Strata <small>local demo</small></span>
      <nav aria-label="Pages">
        {links.map(([href, label]) => (
          <a href={href} aria-current={path === href ? "page" : undefined}>{label}</a>
        ))}
      </nav>
    </header>
    <main>
      <h1>{title}</h1>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --text: #1d232a;
    --muted: #5a6470;
    --surface: #ffffff;
    --page: #f4f5f7;
    --border: #d4d8dd;
    --accent: #0b5cad;
    --error: #a3191f;
    --ok: #1d6b35;
    font: 1rem/1.5 system-ui, sans-serif;
    color: var(--text);
    background: var(--page);
  }
  body { margin: 0; }
  header {
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; align-items: baseline;
    padding: 0.75rem 1rem; background: var(--surface); border-bottom: 1px solid var(--border);
  }
  .brand { font-weight: 600; }
  .brand small { color: var(--muted); font-weight: 400; }
  nav { display: flex; gap: 1rem; flex-wrap: wrap; }
  nav a { color: var(--accent); text-decoration: none; }
  nav a[aria-current="page"] { color: var(--text); font-weight: 600; text-decoration: underline; }
  main { max-width: 48rem; margin: 0 auto; padding: 1rem; }
  h1 { font-size: 1.5rem; margin: 0.5rem 0 1rem; }
  h2 { font-size: 1.125rem; margin: 1.5rem 0 0.5rem; }
  form, .panel {
    display: grid; gap: 0.75rem; padding: 1rem; background: var(--surface);
    border: 1px solid var(--border); border-radius: 4px;
  }
  label { display: grid; gap: 0.25rem; font-weight: 500; }
  input, select, button { font: inherit; }
  input, select { padding: 0.375rem 0.5rem; border: 1px solid var(--border); border-radius: 4px; }
  button {
    justify-self: start; padding: 0.375rem 1rem; border: 1px solid var(--accent); border-radius: 4px;
    background: var(--accent); color: #fff; cursor: pointer;
  }
  button:disabled { opacity: 0.6; cursor: default; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  table { width: 100%; border-collapse: collapse; background: var(--surface); }
  th, td { text-align: left; padding: 0.5rem; border-bottom: 1px solid var(--border); vertical-align: top; }
  code { font-size: 0.875rem; word-break: break-all; }
  .muted { color: var(--muted); }
  blockquote { margin: 0.25rem 0 0; }
  .error { color: var(--error); white-space: pre-wrap; word-break: break-word; }
  .ok { color: var(--ok); }
</style>
