{
  "uid": "strata",
  "title": "Strata",
  "description": "The API and the worker of Strata (tech design 0133).",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
